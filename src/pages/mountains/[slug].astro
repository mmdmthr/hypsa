---
import fs from "node:fs";
import path from "node:path";

import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import MountainPageClient from "../../components/MountainPageClient";
import type { Mountain } from "../../api/mountains";
import { getAllMountains } from "../../api/mountains";
import { supabase } from "../../lib/supabase";

// Explicitly mark as statically pre-rendered (important when using Netlify SSR adapter)
export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
    // Single query — all 315+ mountains with full data fetched once.
    // The result is module-level cached in api/mountains.ts, so any other
    // build-time code that also calls getAllMountains() pays zero extra cost.
    let mountains: Mountain[] = [];
    try {
        mountains = await getAllMountains();
    } catch (err) {
        console.warn("[mountains/[slug]] Could not fetch mountains from Supabase:", err);
    }

    // Build a lookup map for fast O(1) access when merging heightmap-only slugs
    const mountainBySlug = new Map(mountains.map((m) => [m.slug, m]));

    // Also include slugs from heightmap files so 3D-only pages still build
    const heightmapDir = path.join(process.cwd(), "public/heightmaps");
    try {
        const files = fs.readdirSync(heightmapDir) as string[];
        files
            .filter((file: string) => file.endsWith("_heightmap.png"))
            .map((file: string) => file.replace("_heightmap.png", ""))
            .filter((s: string) => !mountainBySlug.has(s))
            .forEach((s: string) => mountainBySlug.set(s, null as unknown as Mountain));
    } catch {
        // heightmaps dir may be empty or missing
    }

    // Each path carries its mountain data as props — no per-page DB query needed
    return [...mountainBySlug.entries()].map(([slug, mountain]) => ({
        params: { slug },
        props: { mountain },
    }));
};

const { slug } = Astro.params;
const { mountain } = Astro.props as { mountain: Mountain | null };

if (!mountain) {
    return Astro.redirect("/404");
}

// Fetch all trails for this mountain
let trails: Array<{ id: string; mountain_id: string; name: string; slug: string }> = [];
try {
    if (mountain?.id) {
        const { data: allTrails, error } = await supabase
            .from("trails_geojson")
            .select("id, mountain_id, name, slug")
            .eq("mountain_id", mountain.id)
            .order("name");
        
        if (error) {
            console.warn(`[mountains/[slug]] Trail query error:`, error.message);
        } else if (allTrails) {
            trails = allTrails;
        }
    }
} catch (err) {
    console.warn("[mountains/[slug]] Trail fetch exception:", err);
}

// Check if a heightmap exists for the 3D viewer
const heightmapPath = path.join(
    process.cwd(),
    "public/heightmaps",
    `${slug}_heightmap.png`,
);
const hasHeightmap = fs.existsSync(heightmapPath);

const provinceName = mountain.provinces?.name ?? "Tidak diketahui";
const elevationFormatted = mountain.elevation.toLocaleString("id-ID");

// SEO metadata
const pageTitle = `${mountain.name} (${elevationFormatted} mdpl) – Gunung Nusantara`;
const pageDescription = `${mountain.name} adalah gunung dengan ketinggian ${elevationFormatted} mdpl yang terletak di ${provinceName}.`;

const canonicalURL = Astro.site
    ? `${Astro.site}mountains/${slug}`
    : Astro.url.href;

// Build bbox from Supabase data when available, otherwise fall back to a default
const hasBbox =
    mountain.min_lat != null &&
    mountain.min_lng != null &&
    mountain.max_lat != null &&
    mountain.max_lng != null;

const bbox = hasBbox
    ? {
          north: mountain.max_lat!,
          south: mountain.min_lat!,
          west: mountain.min_lng!,
          east: mountain.max_lng!,
      }
    : {
          north: -7.339934,
          south: -7.439919,
          west: 110.009976,
          east: 110.129988,
      };
---

<MainLayout
    title={pageTitle}
    description={pageDescription}
    canonicalURL={canonicalURL}
    fullWidth={true}
>
    <div class="max-w-[1600px] mx-auto px-6 py-6">

        <!-- Back link -->
        <a
            href="/"
            class="inline-block mb-4 text-sm text-teal-400 hover:text-teal-300 hover:underline transition-colors"
        >
            ← Kembali ke daftar gunung
        </a>

        <!-- Mountain Header Card -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl px-6 py-5 mb-6">
            <div class="flex flex-wrap items-start justify-between gap-6">
                <!-- Name + Province -->
                <div>
                    <h1 class="text-2xl font-bold text-slate-100 leading-tight">
                        {mountain.name}
                    </h1>
                    <p class="text-teal-400 text-sm font-medium mt-1">
                        {provinceName}
                    </p>
                </div>

                <!-- Stats + Maps link -->
                <div class="flex flex-wrap items-end gap-8">
                    <div>
                        <p class="text-xs uppercase tracking-wide text-slate-400 mb-1">
                            Ketinggian
                        </p>
                        <p class="text-slate-100 font-semibold">
                            {elevationFormatted}
                            <span class="text-slate-400 font-normal text-sm"> mdpl</span>
                        </p>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-slate-400 mb-1">
                            Koordinat
                        </p>
                        <p class="text-slate-100 font-mono text-sm">
                            {mountain.lat.toFixed(5)}, {mountain.lng.toFixed(5)}
                        </p>
                    </div>
                    <a
                        href={`https://www.google.com/maps/@${mountain.lat},${mountain.lng},13z`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-sm text-teal-400 hover:text-teal-300 hover:underline transition-colors pb-0.5"
                    >
                        📍 Lihat di Google Maps
                    </a>
                </div>
            </div>
        </div>

        <!-- Main content grid (managed by React island for shared waypoint state) -->
        <MountainPageClient
            client:only
            slug={slug}
            bbox={bbox}
            mountainId={mountain.id}
            trails={trails}
            hasHeightmap={hasHeightmap}
        />
    </div>
</MainLayout>
