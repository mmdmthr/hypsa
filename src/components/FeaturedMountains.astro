---
import MountainCard from "./MountainCard";
import type { MountainListItem } from "../api/mountains";

interface Props {
  mountains: MountainListItem[];
  featuredSlugs?: string[];
}

const { mountains, featuredSlugs = [] } = Astro.props as Props;

const defaultFeaturedSlugs = [
  // Replace this placeholder list once you decide how featured mountains should be selected.
  "gunung-rinjani",
  "gunung-semeru",
  "gunung-bromo",
  "gunung-gede",
];

const selectedFeaturedSlugs =
  featuredSlugs.length > 0 ? featuredSlugs : defaultFeaturedSlugs;

const featuredMountains = mountains.filter((mountain) =>
  selectedFeaturedSlugs.includes(mountain.slug)
);

const displayMountains = featuredMountains.length > 0 ? featuredMountains : mountains.slice(0, 4);
---

<section class="py-16 bg-surface text-ink dark:bg-ink dark:text-surface">
  <div class="hypsa-container mx-auto">
    <div class="max-w-3xl">
      <p class="text-sm uppercase tracking-[0.24em] text-forest/70 dark:text-beige/70">
        Featured peaks
      </p>
      <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight text-ink dark:text-surface sm:text-4xl">
        Mountains Worth Exploring
      </h2>
      <p class="mt-4 text-base leading-8 text-ink/80 dark:text-surface/80">
        Curated routes and viewpoints from across Indonesia’s most compelling volcanic landscapes.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {displayMountains.map((mountain) => (
        <MountainCard mountain={mountain} />
      ))}
    </div>
  </div>
</section>
