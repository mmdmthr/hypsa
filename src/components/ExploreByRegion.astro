---
import RegionCard from "./RegionCard";
import { getRegionCards } from "../lib/regions";
import type { MountainListItem } from "../api/mountains";

interface Props {
  mountains: MountainListItem[];
}

const { mountains } = Astro.props as Props;
const regions = getRegionCards(mountains);
---

<section id="regions" class="py-16 bg-surface/70 text-ink dark:bg-ink/70 dark:text-surface">
  <div class="hypsa-container mx-auto">
    <div class="max-w-3xl">
      <p class="text-sm uppercase tracking-[0.24em] text-forest/70 dark:text-beige/70">
        By region
      </p>
      <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight text-ink dark:text-surface sm:text-4xl">
        Explore by Region
      </h2>
      <p class="mt-4 text-base leading-8 text-ink/80 dark:text-surface/80">
        A proposed regional grouping based on province names from the mountain dataset.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {regions.map((region) => (
        <RegionCard region={region} />
      ))}
    </div>
  </div>
</section>
