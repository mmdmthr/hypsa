---
import ThemeToggle from "./ThemeToggle.jsx";
import MobileNav from "./MobileNav.tsx";

interface Props {
  variant?: "solid" | "overlay";
}

const { variant = "solid" } = Astro.props as Props;
const isOverlay = variant === "overlay";

const navLinks = [
  { label: "Explore", href: "/explore" },
  { label: "Mountains", href: "/mountains" },
  { label: "Regions", href: "/regions" },
  { label: "About", href: "/about" },
  { label: "Articles", href: "/articles" },
  { label: "GitHub", href: "https://github.com/mmdmthr/hypsa", external: true },
];
---

<header class:list={["w-full", isOverlay ? "absolute inset-x-0 top-0 z-40" : "relative z-30"]}>
  <div class:list={["hypsa-container mx-auto flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8", isOverlay ? "pt-4 sm:pt-6 lg:pt-8" : ""]}>
    <a
      href="/"
      class:list={[
        "flex items-center gap-3 transition",
        isOverlay
          ? "text-surface hover:text-surface/80"
          : "text-ink hover:text-ink/80 dark:text-surface dark:hover:text-surface/80",
      ]}
    >
      <span
        class:list={[
          "flex h-10 w-10 items-center justify-center text-xl",
          isOverlay
            ? "text-surface"
            : "text-ink dark:text-surface",
        ]}
      >
        🏔️
      </span>
      <span class="text-xl font-semibold tracking-tight">Hypsa</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav class="hidden items-center gap-5 md:flex" aria-label="Primary">
        {navLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class:list={[
              "text-sm font-medium transition",
              isOverlay
                ? "text-surface/95 hover:text-surface"
                : "text-ink/90 hover:text-ink dark:text-surface/95 dark:hover:text-surface",
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden sm:block">
        <ThemeToggle client:load />
      </div>
      <div class="md:hidden">
        <MobileNav client:load links={navLinks} />
      </div>
    </div>
  </div>
</header>
